  "verifiedComponentPages": [
    {
      "name": "Buttons",
      "url": "https://developer.apple.com/design/human-interface-guidelines/buttons",
      "lesson": "A button initiates an immediate action; style, content and semantic role need to make its function obvious."
    },
    {
      "name": "Lists and tables",
      "url": "https://developer.apple.com/design/human-interface-guidelines/lists-and-tables",
      "lesson": "Use rows for scannable text and hierarchies; persistent selection is useful for navigation hierarchies."
    },
    {
      "name": "Tab bars",
      "url": "https://developer.apple.com/design/human-interface-guidelines/tab-bars",
      "lesson": "Tab bars navigate top-level areas; they are not action bars."
    },
    {
      "name": "Sidebars",
      "url": "https://developer.apple.com/design/human-interface-guidelines/sidebars",
      "lesson": "Use on wide layouts for a broad flat hierarchy; adapt or collapse when space shrinks."
    },
    {
      "name": "Toolbars",
      "url": "https://developer.apple.com/design/human-interface-guidelines/toolbars",
      "lesson": "Group frequent contextual commands without overcrowding."
    },
    {
      "name": "Menus",
      "url": "https://developer.apple.com/design/human-interface-guidelines/menus",
      "lesson": "Use menus to reveal space-efficient commands while preserving familiar behavior."
    },
    {
      "name": "Alerts",
      "url": "https://developer.apple.com/design/human-interface-guidelines/alerts",
      "lesson": "Use direct neutral language and concise titles; alerts should communicate a situation, not vague error codes."
    },
    {
      "name": "Sheets",
      "url": "https://developer.apple.com/design/human-interface-guidelines/sheets",
      "lesson": "Use for a scoped task closely related to the current context."
    },
    {
      "name": "Pickers",
      "url": "https://developer.apple.com/design/human-interface-guidelines/pickers",
      "lesson": "Useful for medium-to-long predictable choices; avoid them for short lists."
    },
    {
      "name": "Segmented controls",
      "url": "https://developer.apple.com/design/human-interface-guidelines/segmented-controls",
      "lesson": "Use a compact linear set of options for closely related modes or selections."
    },
    {
      "name": "Toggles",
      "url": "https://developer.apple.com/design/human-interface-guidelines/toggles",
      "lesson": "Use only for opposing states such as on/off."
    },
    {
      "name": "Text fields",
      "url": "https://developer.apple.com/design/human-interface-guidelines/text-fields",
      "lesson": "Use for short specific text input; labels remain useful because placeholders disappear."
    },
    {
      "name": "Text views",
      "url": "https://developer.apple.com/design/human-interface-guidelines/text-views",
      "lesson": "Use for larger amounts of text and preserve Dynamic Type and selectable useful information."
    },
    {
      "name": "Labels",
      "url": "https://developer.apple.com/design/human-interface-guidelines/labels",
      "lesson": "Use for small noneditable text; prefer system fonts and semantic label colors."
    },
    {
      "name": "Progress indicators",
      "url": "https://developer.apple.com/design/human-interface-guidelines/progress-indicators",
      "lesson": "Prefer determinate progress when duration is knowable; use spinners for constrained background work."
    },
    {
      "name": "Charts",
      "url": "https://developer.apple.com/design/human-interface-guidelines/charts",
      "lesson": "Highlight a small number of meaningful insights instead of displaying data merely because it exists."
    },
    {
      "name": "Page controls",
      "url": "https://developer.apple.com/design/human-interface-guidelines/page-controls",
      "lesson": "Use for ordered flat pages, not complex hierarchy."
    },
    {
      "name": "Column views",
      "url": "https://developer.apple.com/design/human-interface-guidelines/column-views",
      "lesson": "Useful on macOS for deep hierarchy with frequent back-and-forth navigation."
    }
  ],
